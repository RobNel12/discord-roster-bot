[Unit]
Description=Discord Role and Squad Roster Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/discord-roster-bot
EnvironmentFile=/home/ubuntu/discord-roster-bot/.env
ExecStart=/usr/local/bin/npm start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/discord-roster-bot/data

[Install]
WantedBy=multi-user.target
